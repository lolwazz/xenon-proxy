# Port the local proxy listens on.
PORT=8080

# --- Optional: makes the tunnel URL update itself -------------------------
# Without these, `npm run go` prints the URL and you paste it into the
# WordPress page yourself. With them, it publishes automatically.
#
# Get an application password (NOT your login password):
#   wp-admin -> Users -> Profile -> Application Passwords
#   Name it "xenon-proxy", click Add, copy the generated string.
WP_SITE=https://xenonsschoollearning.online
WP_USER=admin
WP_APP_PASSWORD=
WP_ENDPOINT_PAGE=171

# Password for the proxy. Without it the proxy is an open relay on your home IP.
XENON_PASSWORD=
XENON_SECRET=
